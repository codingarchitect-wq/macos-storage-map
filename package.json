{
  "name": "storagemap",
  "version": "1.0.0",
  "description": "macOS Storage Visualizer - Interactive disk space visualization",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && npm run bundle-renderer && npm run copy-assets",
    "bundle-renderer": "esbuild dist/renderer/index.js --bundle --outfile=dist/renderer/index.bundle.js --platform=browser --external:electron --format=iife",
    "copy-assets": "mkdir -p dist/renderer/styles && cp src/renderer/index.html dist/renderer/ && cp src/renderer/styles/main.css dist/renderer/styles/ && mv dist/renderer/index.bundle.js dist/renderer/index.js",
    "watch": "tsc -w",
    "start": "npm run build && electron . --js-flags='--max-old-space-size=8192'",
    "dev": "concurrently \"npm run watch\" \"electron . --js-flags='--max-old-space-size=8192'\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.27.2",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "d3": "^7.8.5",
    "xxhash-wasm": "^1.0.2"
  },
  "build": {
    "appId": "com.storagemap.app",
    "productName": "StorageMap",
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
